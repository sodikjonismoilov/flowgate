<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flowgate</groupId>
        <artifactId>flowgate</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>flowgate-benchmark</artifactId>
    <name>flowgate-benchmark</name>
    <description>
        JMH microbenchmarks comparing algorithm throughput and latency.
        This module is excluded from the default build (slow shading).
        Build:  mvn clean package -Pbenchmarks -DskipTests
        Run:    java -jar benchmark/target/benchmarks.jar
    </description>

    <dependencies>
        <dependency>
            <groupId>com.flowgate</groupId>
            <artifactId>flowgate-core</artifactId>
        </dependency>
        <!--
            Lettuce arrives transitively via flowgate-core, but the Redis benchmarks
            reference RedisClient/RedisURI directly, so it is declared explicitly here.
            Depending on a type you only get transitively is how builds break silently
            when an upstream module drops a dependency. Version comes from the Spring
            Boot BOM in the parent, so this stays in lockstep with core and service.
        -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <!--
            The annotation processor generates benchmark runner code at compile time.
            Marked "provided" because it's only needed at compile time, not runtime.

            NOTE the artifactId: JMH publishes "jmh-generator-annprocess", not
            "jmh-generator-annproc". The parent's dependencyManagement block manages the
            latter (misspelled) coordinate, which resolves to nothing, so the version is
            pinned here explicitly from the inherited ${jmh.version} property. Fixing the
            parent's entry would let this <version> be dropped again.
        -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Wire the JMH annotation processor into javac so @Benchmark methods
                are discovered and runner scaffolding is generated at compile time.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                maven-shade-plugin bundles all dependencies into a single runnable JAR.
                JMH REQUIRES this — its Main class needs your benchmark classes on the
                classpath at runtime. A regular classpath JAR won't work.

                The ManifestResourceTransformer sets JMH's own Main as the entry point.
                The filter strips signature files that cause SecurityException when mixing
                signed JARs (e.g., Bouncy Castle) into the shaded artifact.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <!--
                                Nothing consumes flowgate-benchmark as a dependency — it is a
                                runnable artifact, not a library — so the dependency-reduced POM
                                shade would otherwise drop in the module root is pure noise in
                                `git status`.
                            -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                                combine.self="override" is required. spring-boot-starter-parent
                                declares its own maven-shade-plugin pluginManagement with a
                                <transformers> list (AppendingTransformers for spring.handlers /
                                spring.schemas). Maven merges inherited configuration lists
                                positionally, so without this the parent's <resource> element
                                lands on our ManifestResourceTransformer and the build fails with
                                "Cannot find 'resource' in ManifestResourceTransformer".
                            -->
                            <transformers combine.self="override">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
